{
  "name": "dsh-update-checker",
  "version": "0.1.0",
  "type": "module",
  "description": "Adds a Check for updates row under the Desktop update channel: reads the newest installer straight from the upstream feed (ignoring staged rollout), checks once per launch or once a day, and downloads, verifies and installs only after the user confirms.",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/typert.host.js",
    "lib/feed.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "update"
  ],
  "dsh": {
    "verifiedAgainst": "0.2.2-rc.3",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
